---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCover from '../components/ProjectCover.astro';
import ResearchScene from '../components/ResearchScene.astro';
import { caseStudies } from '../data/case-studies';
import { about } from '../data/portfolio';
import portrait from '../assets/portraits/hanif-outdoor.jpg';
import aboutPortrait from '../assets/portraits/hanif-architecture.png';
const [featured, ...otherWork] = caseStudies;
---
<Layout home><main id="main">
  <section class="hero-shell" id="top" aria-labelledby="hero-title">
    <div class="container hero">
      <div class="hero-copy">
        <h1 id="hero-title">Hi, I’m<br /><span>Hanif Zhafran.</span></h1>
        <p class="hero-discipline">AI/ML &amp; software engineering</p>
        <p class="hero-description">I turn Arabic documents into usable text, bring vision models to phones, and connect business workflows.</p>
        <div class="hero-actions"><a class="button button-primary" href="#work">Explore the work <span aria-hidden="true">↓</span></a><a class="text-link" href="#contact">Let’s talk</a></div>
      </div>
      <div class="hero-portrait-stage">
        <svg class="hero-linework" viewBox="0 0 440 500" aria-hidden="true" focusable="false">
          <path class="hero-gesture" pathLength="1" d="M22 344 C-2 262 2 132 82 84 C124 58 164 66 146 34 C129 6 88 17 95 45 C102 68 121 75 146 74" />
          <path class="hero-echo" d="M281 444 C341 465 394 422 407 361 M284 454 C337 471 380 449 401 410" />
        </svg>
        <a class="hero-photo" href="#about" aria-label="Get to know Hanif Zhafran">
          <div class="hero-photo-window"><Image src={portrait} alt="Hanif Zhafran in a dark suit, outdoors" widths={[360, 540, 720, 960]} sizes="(min-width: 1051px) 328px, (min-width: 801px) 280px, (min-width: 601px) 308px, 248px" loading="eager" fetchpriority="high" format="webp" quality={85} /></div>
          <span class="hero-photo-caption">Get to know me</span>
        </a>
      </div>
    </div>
  </section>
  <section class="container work-section" id="work" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Selected work</h2><p>Arabic OCR, mobile vision, and business automation.</p></div>
    <article class="featured-project">
      <div class="featured-copy"><h3><a href={`/work/${featured.project.id}/`}>{featured.project.name}</a></h3><p class="project-category">{featured.category}</p><p class="project-headline">{featured.headline}</p><p>{featured.introduction}</p><div class="project-result"><strong>{featured.shortMetric}</strong><span>{featured.shortMetricLabel}</span></div><p class="project-role">My contribution: research, OCR pipeline, evaluation &amp; Android.</p><div class="project-actions"><a class="button button-primary" href={`/work/${featured.project.id}/`}>Explore TashkiFlow <span aria-hidden="true">↗</span></a><a class="text-link" href={featured.repository} target="_blank" rel="noopener noreferrer">Source on GitHub<span class="sr-only">: {featured.project.name} (opens in a new tab)</span></a></div></div>
      <div class="featured-cover"><ResearchScene /></div>
    </article>
    <div class="other-projects">{otherWork.map((study) => <article class="compact-project"><div class="compact-copy"><h3><a href={`/work/${study.project.id}/`}>{study.project.name}</a></h3><p class="project-category">{study.category}</p><p class="compact-introduction">{study.introduction}</p><p class="compact-role">My contribution: {study.project.id === 'tadabburlens' ? 'dataset, model evaluation & Android integration.' : 'database, bot, dashboard & user testing.'}</p></div><a class="cover-link" href={`/work/${study.project.id}/`} aria-label={`Explore ${study.project.name} case study`}><ProjectCover study={study} /></a><div class="compact-bottom"><div class="compact-result"><strong>{study.shortMetric}</strong><span>{study.shortMetricLabel}</span></div><div class="project-links"><a class="text-link" href={`/work/${study.project.id}/`}>View case study<span class="sr-only">: {study.project.name}</span></a><a class="text-link" href={study.repository} target="_blank" rel="noopener noreferrer">Source on GitHub<span class="sr-only">: {study.project.name} (opens in a new tab)</span></a></div></div></article>)}</div>
  </section>
  <section class="about-section" id="about" aria-labelledby="about-title"><div class="container about-layout">
    <div class="about-portrait"><Image src={aboutPortrait} alt="Hanif Zhafran in a dark suit beside a stone column" widths={[360, 480, 640, 900]} sizes="(min-width: 1051px) 330px, (min-width: 801px) 290px, (min-width: 601px) 235px, 230px" loading="lazy" format="webp" quality={85} /></div>
    <div class="about-copy">
      <h2 id="about-title">AI research,<br />with software around it.</h2>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="experience-note">
        <h3>{about.currentWork.title}</h3>
        <p class="experience-period">{about.currentWork.period}</p>
        <p>{about.currentWork.description}</p>
        <p>{about.currentWork.detail}</p>
      </div>
      <div class="experience-note teaching-note">
        <h3>{about.teaching.title}</h3>
        <p class="experience-period">{about.teaching.period}</p>
        <p>{about.teaching.description}</p>
      </div>
      <div class="about-links"><a class="text-link" href="https://github.com/ecHZee" target="_blank" rel="noopener noreferrer">More work on GitHub<span class="sr-only"> (opens in a new tab)</span></a><a class="text-link" href="https://www.linkedin.com/in/hanifzhfran/" target="_blank" rel="noopener noreferrer">LinkedIn profile<span class="sr-only"> (opens in a new tab)</span></a></div>
    </div>
  </div></section>
</main></Layout>
