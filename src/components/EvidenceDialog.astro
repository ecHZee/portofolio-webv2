<dialog class="evidence-dialog" id="evidence-dialog" aria-labelledby="viewer-title" aria-describedby="viewer-caption">
  <div class="viewer-header"><h2 id="viewer-title">Image preview</h2><button class="button button-outline viewer-close" type="button" data-viewer-close autofocus>Close</button></div>
  <div class="viewer-toolbar" aria-label="Image zoom controls"><button type="button" data-viewer-fit>Fit</button><button type="button" data-viewer-actual>1:1</button><button type="button" data-viewer-out aria-label="Zoom out">−</button><output data-viewer-scale aria-live="polite">100%</output><button type="button" data-viewer-in aria-label="Zoom in">+</button><a href="#viewer-caption" data-viewer-original target="_blank" rel="noopener noreferrer">Full image <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
  <div class="viewer-body" tabindex="0" role="region" aria-label="Image viewport. When zoomed, drag or use arrow keys to pan. Plus and minus zoom; zero resets to Fit."><div class="viewer-stage"><p class="viewer-status" role="status" data-viewer-status>Loading image…</p><img data-viewer-image alt="" draggable="false" hidden /><button class="button button-outline" type="button" data-viewer-retry hidden>Retry image</button></div></div>
  <div class="viewer-footer"><p id="viewer-caption"></p><div class="viewer-navigation"><button class="button button-outline" type="button" data-viewer-prev>Previous</button><p data-viewer-counter aria-live="polite"></p><button class="button button-outline" type="button" data-viewer-next>Next</button></div><p class="viewer-help">Read detail with 1:1 · Drag to pan · Escape to close</p></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#evidence-dialog');
  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-viewer-image]')!;
    const viewport = dialog.querySelector<HTMLElement>('.viewer-body')!;
    const stage = dialog.querySelector<HTMLElement>('.viewer-stage')!;
    const caption = dialog.querySelector<HTMLElement>('#viewer-caption')!;
    const status = dialog.querySelector<HTMLElement>('[data-viewer-status]')!;
    const retry = dialog.querySelector<HTMLButtonElement>('[data-viewer-retry]')!;
    const previous = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-viewer-counter]')!;
    const original = dialog.querySelector<HTMLAnchorElement>('[data-viewer-original]')!;
    const navigation = dialog.querySelector<HTMLElement>('.viewer-navigation')!;
    const scaleLabel = dialog.querySelector<HTMLOutputElement>('[data-viewer-scale]')!;
    const zoomIn = dialog.querySelector<HTMLButtonElement>('[data-viewer-in]')!;
    const zoomOut = dialog.querySelector<HTMLButtonElement>('[data-viewer-out]')!;
    const actual = dialog.querySelector<HTMLButtonElement>('[data-viewer-actual]')!;
    const fitButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-fit]')!;
    let items: HTMLAnchorElement[] = [], position = 0, scale = 1, fitScale = 1;
    let opener: HTMLAnchorElement | null = null;
    let previousOverflow = '';
    let loaded = false;
    const zoom = (value: number, reset = false) => {
      if (!loaded) return;
      const centerX = (viewport.scrollLeft + viewport.clientWidth / 2) / scale;
      const centerY = (viewport.scrollTop + viewport.clientHeight / 2) / scale;
      scale = Math.max(fitScale, Math.min(8, value));
      const width = Math.round(image.naturalWidth * scale), height = Math.round(image.naturalHeight * scale);
      image.style.width = `${width}px`; image.style.height = `${height}px`;
      stage.style.width = `max(100%, ${width + 32}px)`; stage.style.height = `max(100%, ${height + 32}px)`;
      viewport.classList.toggle('is-zoomed', scale > fitScale + .001);
      scaleLabel.value = `${Math.round(scale * 100)}%`;
      zoomOut.disabled = scale <= fitScale + .001; zoomIn.disabled = scale >= 8;
      actual.disabled = false; fitButton.disabled = false;
      viewport.scrollLeft = reset ? 0 : centerX * scale - viewport.clientWidth / 2;
      viewport.scrollTop = reset ? 0 : centerY * scale - viewport.clientHeight / 2;
    };
    const fit = () => {
      if (!loaded) return;
      fitScale = Math.min((viewport.clientWidth - 32) / image.naturalWidth, (viewport.clientHeight - 32) / image.naturalHeight, 1);
      zoom(fitScale, true);
    };
    const render = () => {
      const current = items[position];
      loaded = false; scale = 1;
      [zoomIn, zoomOut, actual, fitButton].forEach((button) => button.disabled = true);
      stage.style.width = '100%'; stage.style.height = '100%'; viewport.classList.remove('is-zoomed');
      status.hidden = false; status.textContent = 'Loading image…'; retry.hidden = true; image.hidden = true;
      image.alt = current.dataset.caption || 'Project evidence'; caption.textContent = image.alt;
      counter.textContent = `${position + 1} of ${items.length}`; navigation.hidden = items.length < 2;
      previous.disabled = position === 0; next.disabled = position === items.length - 1;
      original.href = current.href; image.src = current.href;
    };
    image.addEventListener('load', () => { loaded = true; image.hidden = false; status.hidden = true; fit(); });
    image.addEventListener('error', () => { status.textContent = 'This image could not load. Retry or open the full image.'; retry.hidden = false; });
    retry.addEventListener('click', () => { image.removeAttribute('src'); render(); });
    fitButton.addEventListener('click', fit); actual.addEventListener('click', () => zoom(1));
    zoomIn.addEventListener('click', () => zoom(scale * 1.5)); zoomOut.addEventListener('click', () => zoom(scale / 1.5));
    new ResizeObserver(() => { if (dialog.open && loaded) fit(); }).observe(dialog);
    let drag: { id: number; x: number; y: number; left: number; top: number } | null = null;
    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || scale <= fitScale + .001) return;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
      viewport.setPointerCapture(event.pointerId); viewport.focus({ preventScroll: true });
    });
    viewport.addEventListener('pointermove', (event) => { if (!drag || event.pointerId !== drag.id) return; viewport.scrollLeft = drag.left - (event.clientX - drag.x); viewport.scrollTop = drag.top - (event.clientY - drag.y); });
    const endDrag = () => { drag = null; };
    viewport.addEventListener('pointerup', endDrag); viewport.addEventListener('pointercancel', endDrag); viewport.addEventListener('lostpointercapture', endDrag);
    const step = (direction: number) => { const target = position + direction; if (target >= 0 && target < items.length) { position = target; render(); } };
    previous.addEventListener('click', () => step(-1)); next.addEventListener('click', () => step(1));
    dialog.querySelector('[data-viewer-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        const controls = Array.from(dialog.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], [tabindex="0"]')).filter((control) => control.getClientRects().length > 0);
        const first = controls[0], last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        return;
      }
      if (event.key === '+' || event.key === '=') { event.preventDefault(); zoom(scale * 1.5); }
      if (event.key === '-') { event.preventDefault(); zoom(scale / 1.5); }
      if (event.key === '0') { event.preventDefault(); fit(); }
      if (document.activeElement === viewport && scale > fitScale + .001 && event.key.startsWith('Arrow')) {
        event.preventDefault(); viewport.scrollBy({ left: event.key === 'ArrowLeft' ? -80 : event.key === 'ArrowRight' ? 80 : 0, top: event.key === 'ArrowUp' ? -80 : event.key === 'ArrowDown' ? 80 : 0 }); return;
      }
      if (event.key === 'ArrowLeft') { event.preventDefault(); step(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); step(1); }
    });
    dialog.addEventListener('click', (event) => { if (event.target !== dialog) return; const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); });
    dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; opener?.focus({ preventScroll: true }); });
    document.querySelectorAll<HTMLAnchorElement>('[data-view-image]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0 || typeof dialog.showModal !== 'function') return;
        event.preventDefault(); opener = link;
        const group = link.closest('[data-gallery]');
        items = group ? Array.from(group.querySelectorAll<HTMLAnchorElement>('[data-view-image]')).filter((item) => !item.hidden) : [link]; position = items.indexOf(link);
        previousOverflow = document.body.style.overflow; render(); dialog.showModal(); document.body.style.overflow = 'hidden';
      });
    });
  }
</script>
